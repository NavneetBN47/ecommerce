        TIMESTAMP updated_at
    }
    
    ORDER_ITEMS {
        BIGINT id PK
        BIGINT order_id FK
        BIGINT product_id FK
        INT quantity
        DECIMAL price
        DECIMAL subtotal
        TIMESTAMP created_at
