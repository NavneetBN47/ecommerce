        VARCHAR sku UK
        VARCHAR name
        VARCHAR description
        DECIMAL price
        INT stock_quantity
        VARCHAR image_url
        BIGINT category_id FK
        BOOLEAN active
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }
    
    ADDRESSES {
