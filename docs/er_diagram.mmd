erDiagram
    USERS ||--o{ CARTS : "has"
    USERS ||--o{ ORDERS : "places"
    CARTS ||--o{ CART_ITEMS : "contains"
    PRODUCTS ||--o{ CART_ITEMS : "included in"
    PRODUCTS ||--o{ ORDER_ITEMS : "included in"
    ORDERS ||--o{ ORDER_ITEMS : "contains"

    USERS {
        bigint id PK
        varchar username UK "NOT NULL"
        varchar email UK "NOT NULL"
        varchar password "NOT NULL"
        varchar first_name
        varchar last_name
        varchar phone_number
        boolean active "DEFAULT TRUE"
        timestamp created_at "NOT NULL"
        timestamp updated_at
    }

    PRODUCTS {
        bigint id PK
        varchar name "NOT NULL"
        text description
        varchar sku UK "NOT NULL"
        decimal price "NOT NULL CHECK > 0"
        integer stock_quantity "NOT NULL CHECK >= 0"
        varchar category
        varchar image_url
        boolean active "DEFAULT TRUE"
        timestamp created_at "NOT NULL"
        timestamp updated_at
    }

    CARTS {
        bigint id PK
        bigint user_id FK "NOT NULL"
        varchar status "DEFAULT ACTIVE"
        decimal total_amount "DEFAULT 0.00"
        integer total_items "DEFAULT 0"
        timestamp created_at "NOT NULL"
        timestamp updated_at
    }

    CART_ITEMS {
        bigint id PK
        bigint cart_id FK "NOT NULL"
        bigint product_id FK "NOT NULL"
        integer quantity "NOT NULL CHECK >= 1"
        decimal price "NOT NULL"
        timestamp created_at "NOT NULL"
        timestamp updated_at
    }

    ORDERS {
        bigint id PK
        varchar order_number UK "NOT NULL"
        bigint user_id FK "NOT NULL"
        varchar status "DEFAULT PENDING"
        decimal total_amount "NOT NULL"
        text shipping_address
        text billing_address
        timestamp created_at "NOT NULL"
        timestamp updated_at
    }

    ORDER_ITEMS {
        bigint id PK
        bigint order_id FK "NOT NULL"
        bigint product_id FK "NOT NULL"
        integer quantity "NOT NULL CHECK >= 1"
        decimal price "NOT NULL"
        timestamp created_at "NOT NULL"
    }