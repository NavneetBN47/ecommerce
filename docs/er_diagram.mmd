erDiagram
    USERS ||--o| CART : "owns"
    CART ||--|{ CART_ITEMS : "contains"
    CART_ITEMS }o--|| PRODUCTS : "references"

    USERS {
        UUID user_id PK
        VARCHAR username UK "UNIQUE, NOT NULL"
        VARCHAR password_hash "NOT NULL"
        VARCHAR full_name "NOT NULL"
        VARCHAR email "NOT NULL"
        TIMESTAMP created_at "NOT NULL, DEFAULT CURRENT_TIMESTAMP"
    }

    PRODUCTS {
        UUID product_id PK
        VARCHAR name "NOT NULL"
        TEXT description
        DECIMAL price "NOT NULL, CHECK >= 0"
        INTEGER available_qty "NOT NULL, CHECK >= 0"
    }

    CART {
        UUID cart_id PK
        UUID user_id FK,UK "UNIQUE, NOT NULL, REFERENCES users(user_id) ON DELETE CASCADE"
        TIMESTAMP created_at "NOT NULL, DEFAULT CURRENT_TIMESTAMP"
    }

    CART_ITEMS {
        UUID cart_item_id PK
        UUID cart_id FK "NOT NULL, REFERENCES cart(cart_id) ON DELETE CASCADE"
        UUID product_id FK "NOT NULL, REFERENCES products(product_id)"
        INTEGER quantity "NOT NULL, CHECK > 0"
    }