erDiagram
    USERS ||--o{ CARTS : "has"
    USERS ||--o{ ORDERS : "places"
    CARTS ||--o{ CART_ITEMS : "contains"
    PRODUCTS ||--o{ CART_ITEMS : "in"
    PRODUCTS ||--o{ ORDER_ITEMS : "in"
    ORDERS ||--o{ ORDER_ITEMS : "contains"

    USERS {
        BIGINT id PK
        VARCHAR username UK
        VARCHAR email UK
        VARCHAR password
        VARCHAR first_name
        VARCHAR last_name
        VARCHAR phone_number
        VARCHAR address
        VARCHAR city
        VARCHAR state
        VARCHAR zip_code
        VARCHAR country
        ENUM role
        ENUM status
        DATETIME last_login
        DATETIME created_at
        DATETIME updated_at
    }

    PRODUCTS {
        BIGINT id PK
        VARCHAR name
        TEXT description
        VARCHAR sku UK
        DECIMAL price
        DECIMAL discount_price
        INT stock_quantity
        VARCHAR category
        VARCHAR brand
        VARCHAR image_url
        BOOLEAN active
        BOOLEAN featured
        DECIMAL rating
        INT review_count
        DATETIME created_at
        DATETIME updated_at
    }

    CARTS {
        BIGINT id PK
        BIGINT user_id FK,UK
        DECIMAL total_amount
        INT total_items
        DATETIME created_at
        DATETIME updated_at
    }

    CART_ITEMS {
        BIGINT id PK
        BIGINT cart_id FK
        BIGINT product_id FK
        INT quantity
        DECIMAL unit_price
        DECIMAL subtotal
        DATETIME created_at
        DATETIME updated_at
    }

    ORDERS {
        BIGINT id PK
        VARCHAR order_number UK
        BIGINT user_id FK
        ENUM status
        DECIMAL total_amount
        INT total_items
        TEXT shipping_address
        TEXT billing_address
        ENUM payment_method
        ENUM payment_status
        DATETIME order_date
        DATETIME shipped_date
        DATETIME delivered_date
        TEXT notes
        DATETIME created_at
        DATETIME updated_at
    }

    ORDER_ITEMS {
        BIGINT id PK
        BIGINT order_id FK
        BIGINT product_id FK
        VARCHAR product_name
        VARCHAR product_sku
        INT quantity
        DECIMAL unit_price
        DECIMAL subtotal
        DATETIME created_at
    }