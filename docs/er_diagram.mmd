        BIGINT id PK
        VARCHAR username UK
        VARCHAR email UK
        VARCHAR password
        VARCHAR first_name
        VARCHAR last_name
        VARCHAR phone_number
        BOOLEAN active
        BOOLEAN email_verified
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }
    
    CATEGORIES {
        BIGINT id PK
        VARCHAR name UK
        VARCHAR description
        BOOLEAN active
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }
    
    PRODUCTS {
