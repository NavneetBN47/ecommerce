      "post": {
        "tags": ["Orders"],
        "summary": "Cancel order",
        "description": "Cancel an existing order",
        "operationId": "cancelOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Order ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Order cancelled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseDTO"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
