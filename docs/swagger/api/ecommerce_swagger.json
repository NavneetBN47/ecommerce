          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "User last name",
            "example": "Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "User email address",
            "example": "john.doe@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 100,
            "description": "User password",
            "example": "password123"
          },
          "phoneNumber": {
            "type": "string",
            "pattern": "^[+]?[1-9]\\d{1,14}$",
            "description": "User phone number",
            "example": "+1234567890"
          }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "User first name"
