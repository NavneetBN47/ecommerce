{
  "openapi": "3.0.3",
  "info": {
    "title": "Ecommerce Cart API",
    "version": "1.0.0",
    "description": "API for managing shopping carts in the ecommerce platform"
  },
  "servers": [
    {
      "url": "/api",
      "description": "API base path"
    }
  ],
  "paths": {
    "/carts/{cartId}": {
      "get": {
        "summary": "View cart",
        "description": "Retrieve cart details by cart ID",
        "operationId": "viewCart",
        "parameters": [
          {
            "name": "cartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Cart identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Cart retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartDTO"
                }
              }
            }
          },
          "404": {
            "description": "Cart not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/carts/{cartId}/items": {
      "post": {
        "summary": "Add item to cart",
        "description": "Add a new item to the specified cart",
        "operationId": "addItemToCart",
        "parameters": [
          {
            "name": "cartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Cart identifier"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddItemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item added to cart successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartDTO"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Cart not found or Product not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Product not available or insufficient stock",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Cleanup cart",
        "description": "Remove all items from the cart",
        "operationId": "cleanupCart",
        "parameters": [
          {
            "name": "cartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Cart identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Cart cleaned up successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartDTO"
                }
              }
            }
          },
          "404": {
            "description": "Cart not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/carts/{cartId}/items/{itemId}": {
      "delete": {
        "summary": "Remove item from cart",
        "description": "Remove a specific item from the cart",
        "operationId": "removeItemFromCart",
        "parameters": [
          {
            "name": "cartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Cart identifier"
          },
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Cart item identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Item removed from cart successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartDTO"
                }
              }
            }
          },
          "404": {
            "description": "Cart not found or Cart item not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/carts/user/{userId}": {
      "post": {
        "summary": "Get or create cart for user",
        "description": "Retrieve existing cart or create a new cart for the specified user",
        "operationId": "getOrCreateCartForUser",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "User identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Cart retrieved or created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartDTO"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/carts/logout/{userId}": {
      "post": {
        "summary": "Logout cleanup",
        "description": "Perform cleanup operations when user logs out",
        "operationId": "logoutCleanup",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "User identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Logout cleanup completed successfully"
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddItemRequest": {
        "type": "object",
        "required": ["productId", "quantity"],
        "properties": {
          "productId": {
            "type": "string",
            "description": "Product identifier",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "description": "Quantity of the product to add",
            "minimum": 1
          }
        }
      },
      "CartDTO": {
        "type": "object",
        "properties": {
          "cartId": {
            "type": "string",
            "description": "Cart identifier"
          },
          "items": {
            "type": "array",
            "description": "List of items in the cart",
            "items": {
              "$ref": "#/components/schemas/CartItemDTO"
            }
          },
          "totalAmount": {
            "type": "number",
            "format": "double",
            "description": "Total amount of all items in the cart",
            "minimum": 0
          },
          "totalItems": {
            "type": "integer",
            "description": "Total number of items in the cart",
            "minimum": 0
          },
          "userId": {
            "type": "string",
            "description": "User identifier who owns the cart"
          }
        }
      },
      "CartItemDTO": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "description": "Cart item identifier"
          },
          "price": {
            "type": "number",
            "format": "double",
            "description": "Price per unit of the product",
            "minimum": 0
          },
          "productId": {
            "type": "string",
            "description": "Product identifier"
          },
          "productName": {
            "type": "string",
            "description": "Name of the product"
          },
          "quantity": {
            "type": "integer",
            "description": "Quantity of the product in the cart",
            "minimum": 1
          },
          "subtotal": {
            "type": "number",
            "format": "double",
            "description": "Subtotal for this item (price * quantity)",
            "minimum": 0
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error type or category"
          },
          "message": {
            "type": "string",
            "description": "Detailed error message"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the error occurred"
          }
        }
      }
    }
  }
}