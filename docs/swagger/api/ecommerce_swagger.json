{
  "openapi": "3.0.3",
  "info": {
    "title": "Ecommerce Cart API",
    "version": "1.0.0",
    "description": "API for cart management operations"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Development server"
    }
  ],
  "paths": {
    "/api/cart/{userId}": {
      "get": {
        "tags": ["Cart"],
        "summary": "Get cart for user",
        "description": "Retrieve the cart for a specific user",
        "operationId": "getCart",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Cart retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartDTO"
                }
              }
            }
          },
          "404": {
            "description": "Cart not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Cart"],
        "summary": "Create cart for user",
        "description": "Create a new cart for a specific user",
        "operationId": "createCart",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "User ID"
          }
        ],
        "responses": {
          "201": {
            "description": "Cart created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartDTO"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cart/{userId}/items": {
      "post": {
        "tags": ["Cart Items"],
        "summary": "Add item to cart",
        "description": "Add an item to the user's cart",
        "operationId": "addItemToCart",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "User ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddItemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item added to cart successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartDTO"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid input or insufficient stock",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Cart, product, or user not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Product not available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cart/{userId}/items/{itemId}": {
      "delete": {
        "tags": ["Cart Items"],
        "summary": "Remove item from cart",
        "description": "Remove a specific item from the user's cart",
        "operationId": "removeItemFromCart",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "User ID"
          },
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Cart Item ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Item removed from cart successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartDTO"
                }
              }
            }
          },
          "404": {
            "description": "Cart or cart item not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cart/{userId}/clear": {
      "delete": {
        "tags": ["Cart"],
        "summary": "Clear cart",
        "description": "Remove all items from the user's cart",
        "operationId": "clearCart",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Cart cleared successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartDTO"
                }
              }
            }
          },
          "404": {
            "description": "Cart not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cart/logout/{userId}": {
      "post": {
        "tags": ["Cart"],
        "summary": "Logout cleanup",
        "description": "Perform cleanup operations when user logs out",
        "operationId": "logoutCleanup",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Logout cleanup completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Logout cleanup completed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddItemRequest": {
        "type": "object",
        "required": ["productId", "quantity"],
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int64",
            "description": "Product ID",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "description": "Quantity of the product",
            "minimum": 1
          }
        }
      },
      "CartDTO": {
        "type": "object",
        "properties": {
          "cartId": {
            "type": "integer",
            "format": "int64",
            "description": "Cart ID"
          },
          "userId": {
            "type": "integer",
            "format": "int64",
            "description": "User ID"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItemDTO"
            },
            "description": "List of cart items"
          },
          "totalAmount": {
            "type": "number",
            "format": "double",
            "description": "Total amount of the cart",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Cart creation timestamp"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Cart last update timestamp"
          }
        }
      },
      "CartItemDTO": {
        "type": "object",
        "properties": {
          "cartItemId": {
            "type": "integer",
            "format": "int64",
            "description": "Cart item ID"
          },
          "productId": {
            "type": "integer",
            "format": "int64",
            "description": "Product ID"
          },
          "productName": {
            "type": "string",
            "description": "Product name"
          },
          "price": {
            "type": "number",
            "format": "double",
            "description": "Product price",
            "minimum": 0
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "description": "Quantity of the product",
            "minimum": 1
          },
          "subtotal": {
            "type": "number",
            "format": "double",
            "description": "Subtotal for this item",
            "minimum": 0
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error type or code"
          },
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Error timestamp"
          },
          "path": {
            "type": "string",
            "description": "Request path that caused the error"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Cart",
      "description": "Cart management operations"
    },
    {
      "name": "Cart Items",
      "description": "Cart item management operations"
    }
  ]
}